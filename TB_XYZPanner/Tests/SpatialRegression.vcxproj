<?xml version="1.0" encoding="UTF-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Inherit the production compiler, CRT and JUCE definitions to avoid ABI drift. -->
  <Import Project="..\Builds\VisualStudio2022\TB_XYZPanner_SharedCode.vcxproj" />
  <PropertyGroup>
    <ConfigurationType>Application</ConfigurationType>
    <TargetExt>.exe</TargetExt>
    <TargetName>SpatialRegression</TargetName>
    <OutDir>$(MSBuildThisFileDirectory)out\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)out\obj\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <ClCompile Remove="@(ClCompile)" />
    <ResourceCompile Remove="@(ResourceCompile)" />
    <ClCompile Include="SpatialRegression.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <DebugInformationFormat>OldStyle</DebugInformationFormat>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\JuceLibraryCode;C:\JUCE\modules;C:\JUCE\modules\juce_audio_processors_headless\format_types\VST3_SDK</AdditionalIncludeDirectories>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)SpatialRegression.pdb</ProgramDataBaseFileName>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <OutputFile>$(OutDir)$(TargetName)$(TargetExt)</OutputFile>
      <AdditionalDependencies>$(MSBuildThisFileDirectory)..\Builds\VisualStudio2022\x64\Release\Shared Code\TB_XYZPanner.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ProgramDatabaseFile>$(OutDir)SpatialRegression.pdb</ProgramDatabaseFile>
    </Link>
  </ItemDefinitionGroup>
</Project>
